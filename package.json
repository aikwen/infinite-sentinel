{
  "name": "infinite-sentinel",
  "version": "0.1.0",
  "description": "A lightweight Vue 3 sentinel component for infinite scroll and incremental loading.",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/infinite-sentinel.js",
  "module": "./dist/infinite-sentinel.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/infinite-sentinel.js"
    },
    "./style.css": "./dist/infinite-sentinel.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check build:types build-only",
    "build-only": "vite build",
    "build:types": "vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "keywords": [
    "vue",
    "vue3",
    "intersection-observer",
    "infinite-scroll",
    "sentinel",
    "incremental-loading"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aikwen/infinite-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/aikwen/infinite-sentinel/issues"
  },
  "homepage": "https://github.com/aikwen/infinite-sentinel#readme",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}